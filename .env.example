# Optional runtime overrides
SS_APP_HOST=127.0.0.1
SS_APP_PORT=8080
SS_DATABASE_TYPE=sqlite
SS_DATABASE_PATH=./data/self_systems.db
SS_DATABASE_URL=
# Example when using PostgreSQL:
# SS_DATABASE_URL=postgres://selfsystems:selfsystems@127.0.0.1:5432/self_systems?sslmode=disable
# Example when using VPS Docker topology (api service inside compose network):
# SS_DATABASE_URL=postgres://selfsystems:selfsystems@postgres:5432/self_systems?sslmode=disable
SS_POSTGRES_DB=self_systems
SS_POSTGRES_USER=selfsystems
SS_POSTGRES_PASSWORD=selfsystems
SS_POSTGRES_PORT=5432
SS_PUBLIC_HTTP_PORT=80

# AI provider selection
SS_AI_PRIMARY_PROVIDER=heuristic

# OpenAI provider
SS_AI_OPENAI_ENABLED=false
SS_AI_OPENAI_API_KEY=
SS_AI_OPENAI_MODEL=gpt-4o-mini
SS_AI_OPENAI_BASE_URL=https://api.openai.com
SS_AI_OPENAI_TIMEOUT_SECONDS=20

# Anthropic provider
SS_AI_ANTHROPIC_ENABLED=false
SS_AI_ANTHROPIC_API_KEY=
SS_AI_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
SS_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
SS_AI_ANTHROPIC_TIMEOUT_SECONDS=20

# Gemini provider
SS_AI_GEMINI_ENABLED=false
SS_AI_GEMINI_API_KEY=
SS_AI_GEMINI_MODEL=gemini-1.5-flash
SS_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
SS_AI_GEMINI_TIMEOUT_SECONDS=20

# Feature flags
SS_FEATURES_SKIM_ENABLED=true
SS_FEATURES_DEEP_ENABLED=true
SS_FEATURES_UNIFIED_CHAT_ENABLED=true
SS_FEATURES_REMINDER_ENABLED=true
SS_FEATURES_TODO_ENABLED=true

# Phase 2 deep processing and cost controls
SS_PROCESSING_DEEP_ENABLED=true
SS_PROCESSING_DEEP_QUEUE_CAPACITY=256
SS_PROCESSING_DEEP_WORKER_COUNT=1
SS_PROCESSING_DEEP_MAX_TASKS_PER_MINUTE=30
SS_PROCESSING_DEEP_MAX_TOKENS_PER_DAY=200000
SS_PROCESSING_DEEP_COMPLEXITY_THRESHOLD=6
SS_PROCESSING_DEEP_LOW_COST_MODEL=gpt-4o-mini
SS_PROCESSING_DEEP_HIGH_COST_MODEL=gpt-4o
SS_PROCESSING_DEEP_LOW_COST_ESTIMATED_TOKENS=250
SS_PROCESSING_DEEP_HIGH_COST_ESTIMATED_TOKENS=1200

# Phase 2 sync backbone
SS_SYNC_ENABLED=true
SS_SYNC_WEBSOCKET_PATH=/api/v1/sync/ws
SS_SYNC_ALLOWED_ORIGINS=
SS_SYNC_HEARTBEAT_SECONDS=30

# Phase 2 auth backbone
SS_AUTH_ENABLED=false
SS_AUTH_GOOGLE_CLIENT_ID=
SS_AUTH_GOOGLE_CLIENT_SECRET=
SS_AUTH_GOOGLE_REDIRECT_URL=
SS_AUTH_JWT_SECRET=
SS_AUTH_JWT_ISSUER=self-systems
SS_AUTH_JWT_AUDIENCE=self-systems-clients
SS_AUTH_TOKEN_TTL_MINUTES=60
